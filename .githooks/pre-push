#!/bin/sh
# Block a push that doesn't bump src/version.js, or whose index.html wasn't
# rebuilt after the bump. Scheme (README's Versioning section):
#   more than one push in a day  -> third number   (1.2 -> 1.2.1)
#   the day's first push         -> second number  (1.2 -> 1.3)
#   new pages / major features   -> first number   (1.x -> 2.0)
#
# Enable (once per clone): git config core.hooksPath .githooks
# Bypass for docs-only or CI-only pushes: git push --no-verify

VERSION_FILE="src/version.js"
ZERO="0000000000000000000000000000000000000000"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$ZERO" ] && continue
	[ "$remote_sha" = "$ZERO" ] && continue

	current=$(git show "$local_sha:$VERSION_FILE" 2>/dev/null | sed -n "s/.*VERSION = '\(.*\)'.*/\1/p")

	if git diff --quiet "$remote_sha" "$local_sha" -- "$VERSION_FILE"; then
		echo "" >&2
		echo "  push blocked: $VERSION_FILE is unchanged (currently ${current:-unknown})" >&2
		echo "  edit it, run python3 scripts/build_site.py, commit, then push again." >&2
		echo "  (docs-only or CI-only? git push --no-verify)" >&2
		echo "" >&2
		status=1
	elif ! git show "$local_sha:index.html" | grep -qF "<span>$current</span>"; then
		echo "" >&2
		echo "  push blocked: index.html does not carry $current" >&2
		echo "  run python3 scripts/build_site.py and commit the result." >&2
		echo "" >&2
		status=1
	fi
done

exit $status
